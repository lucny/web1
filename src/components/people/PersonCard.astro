---
import type { PersonEntry } from '../../lib/people';
import { formatPersonName, getPersonPhoto, getPersonPosition, getPersonWorkplace } from '../../lib/people';
import { withBase } from '../../lib/content';
import PersonMeta from './PersonMeta.astro';

type Variant = 'vertical' | 'compact' | 'list';

interface Props {
  person: PersonEntry;
  variant?: Variant;
  showPhoto?: boolean;
  showPhone?: boolean;
  showWorkplace?: boolean;
  showStudyFields?: boolean;
  interactive?: boolean;
}

const {
  person,
  variant = 'vertical',
  showPhoto = true,
  showPhone = false,
  showWorkplace = true,
  showStudyFields = false,
  interactive = true
} = Astro.props as Props;
const data = person.data;
const photo = getPersonPhoto(data);
const name = formatPersonName(data);
const position = getPersonPosition(data);
const workplace = getPersonWorkplace(data);
const profileUrl = withBase(`/kontakt/${person.id}/`);
---

<article
  class:list={["person-card", `person-card-${variant}`, "card", photo && showPhoto && "person-card-has-photo"]}
  data-person-open={interactive ? person.id : undefined}
  data-person-card
  tabindex={interactive ? 0 : undefined}
  role={interactive ? 'button' : undefined}
  aria-label={interactive ? `Otevřít profil: ${name}` : undefined}
>
  {showPhoto && photo && <a class="person-card-photo" href={profileUrl} tabindex="-1" aria-hidden="true">
    <img src={withBase(photo.src)} alt={photo.alt} loading="lazy" style={photo.focalPoint ? `object-position:${photo.focalPoint}` : undefined} />
  </a>}
  <div class="person-card-content">
    {workplace && <p class="person-card-workplace">{workplace}</p>}
    <h2 class="person-card-name"><a href={profileUrl} class="no-underline hover:text-brand">{name}</a></h2>
    <p class="person-card-position">{position}</p>
    <PersonMeta person={person} showWorkplace={showWorkplace && !workplace} showPhone={showPhone} showStudyFields={showStudyFields} compact={variant !== 'vertical'} />
  </div>
</article>
