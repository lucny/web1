---
import { withBase } from '../lib/content';

const navigation = [
  {
    label: 'Škola',
    items: [
      { href: '/skola/o-skole/', label: 'O škole' },
      { href: '/kontakt/', label: 'Vedení a kontakty' },
      { href: '/skola/pro-studenty/', label: 'Pro studenty' }
    ]
  },
  {
    label: 'Studium',
    items: [
      { href: '/obory/', label: 'Studijní obory' },
      { href: '/uchazeci/', label: 'Uchazeči' },
      { href: '/studenti/', label: 'Studenti a rodiče' }
    ]
  },
  {
    label: 'Dokumenty',
    items: [
      { href: '/dokumenty/', label: 'Přehled dokumentů' },
      { href: '/uchazeci/', label: 'Přijímací řízení' },
      { href: '/skola/pro-studenty/', label: 'Školní řád a podpora' }
    ]
  },
  {
    label: 'Aktuality',
    items: [
      { href: '/aktuality/', label: 'Školní zpravodaj' },
      { href: '/udalosti/', label: 'Kalendář akcí' },
      { href: '/galerie/', label: 'Galerie' }
    ]
  },
  {
    label: 'Rozcestník',
    items: [
      { href: '/uchazeci/', label: 'Jsem uchazeč' },
      { href: '/studenti/', label: 'Jsem student nebo rodič' },
      { href: '/kontakt/', label: 'Veřejnost a partneři' }
    ]
  }
];
const current = Astro.url.pathname.slice(import.meta.env.BASE_URL.length - 1);
const isActive = (items: { href: string }[]) => items.some((item) => current.startsWith(item.href));
---
<a class="skip-link" href="#main-content">Přeskočit na obsah</a>
<header data-pagefind-ignore class="relative z-30 border-b border-ink/10 bg-white shadow-[0_12px_35px_-30px_rgb(7_27_49/70%)]">
  <div class="bg-night text-white">
    <div class="container-page flex min-h-10 items-center justify-between gap-4 text-xs font-bold">
      <p class="hidden tracking-wide text-white/70 sm:block">Střední škola průmyslová a umělecká, Opava</p>
      <nav aria-label="Rychlé odkazy" class="ml-auto flex items-center gap-1.5">
        <a class="quick-link" href="https://www.facebook.com/sspuopava" target="_blank" rel="noreferrer" aria-label="SŠPU Opava na Facebooku" title="Facebook">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M13.6 21v-8h2.7l.4-3.1h-3.1V7.95c0-.9.25-1.5 1.55-1.5H16.8V3.67c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.05 1.47-4.05 4.17V9.9H7.6V13h2.73v8h3.27Z" /></svg><span class="sr-only">Facebook</span>
        </a>
        <a class="quick-link" href="https://moodle.sspu-opava.cz" target="_blank" rel="noreferrer" aria-label="Moodle SŠPU Opava" title="Moodle">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 9 9-5 9 5-9 5-9-5Z" /><path d="M6 11v5.5c3.6 2.3 8.4 2.3 12 0V11M21 9v6" /></svg><span class="sr-only">Moodle</span>
        </a>
        <a class="quick-link" href="https://portal.office.com" target="_blank" rel="noreferrer" aria-label="Microsoft 365" title="Microsoft 365">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h8v8H3V3Zm10 0h8v8h-8V3ZM3 13h8v8H3v-8Zm10 0h8v8h-8v-8Z" /></svg><span class="sr-only">Microsoft 365</span>
        </a>
        <a class="quick-link" href="https://skolaonline.cz" target="_blank" rel="noreferrer" aria-label="Škola Online" title="Škola Online">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="m8 12 2.5 2.5L16.5 9" /></svg><span class="sr-only">Škola Online</span>
        </a>
      </nav>
    </div>
  </div>

  <div class="container-page flex min-h-28 items-center justify-between gap-6 py-4">
    <a href={withBase('/')} class="shrink-0 no-underline" aria-label="SŠPU Opava – úvodní stránka">
      <img src={withBase('/images/sspu-logo.png')} alt="SŠPU – Střední škola průmyslová a umělecká, Opava" width="560" height="166" class="h-auto w-[min(17rem,58vw)]" />
    </a>
    <form action={withBase('/vyhledavani/')} method="get" role="search" class="hidden w-full max-w-md items-center gap-2 lg:flex">
      <label class="sr-only" for="header-search">Hledat na webu</label>
      <input id="header-search" name="q" type="search" class="min-h-12 w-full rounded-xl bg-mist px-4 text-base placeholder:text-ink/45" placeholder="Hledat na webu" />
      <button class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-night text-white transition hover:bg-brand" type="submit" aria-label="Hledat">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 5 5" /></svg>
      </button>
    </form>
    <a href={withBase('/vyhledavani/')} class="grid h-11 w-11 place-items-center rounded-xl border border-ink/15 text-night no-underline lg:hidden" aria-label="Otevřít vyhledávání">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 5 5" /></svg>
    </a>
  </div>

  <div class="border-t border-ink/10 bg-mist/80">
    <div class="container-page flex min-h-16 items-center justify-between gap-4">
      <nav aria-label="Hlavní navigace" class="hidden lg:block">
        <ul class="flex items-stretch gap-1">
          <li><a href={withBase('/')} aria-label="Úvodní stránka" class:list={["grid min-h-11 w-11 place-items-center rounded-xl no-underline transition hover:bg-white hover:text-brand", current === '/' && 'bg-white text-brand']}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="m12 3 9 8h-2v9h-5v-6H10v6H5v-9H3l9-8Z" /></svg>
          </a></li>
          {navigation.map((group) => <li class="relative">
            <details class="group">
              <summary class:list={["flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-xl px-3 py-2 text-sm font-bold transition hover:bg-white hover:text-brand", isActive(group.items) && 'bg-white text-brand']}>
                {group.label}<svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 transition group-open:rotate-180"><path d="m5 7 5 5 5-5" /></svg>
              </summary>
              <div class="absolute left-0 top-[calc(100%+.4rem)] z-50 min-w-60 rounded-2xl border border-ink/10 bg-white p-2 shadow-lift">
                {group.items.map((item) => <a href={withBase(item.href)} class:list={["block rounded-xl px-4 py-3 text-sm font-bold no-underline transition hover:bg-mist hover:text-brand", current.startsWith(item.href) && 'bg-mist text-brand']}>{item.label}</a>)}
              </div>
            </details>
          </li>)}
          <li><a href={withBase('/kontakt/')} class:list={["flex min-h-11 items-center rounded-xl px-3 py-2 text-sm font-bold no-underline transition hover:bg-white hover:text-brand", current.startsWith('/kontakt/') && 'bg-white text-brand']}>Kontakty</a></li>
        </ul>
      </nav>

      <details class="relative ml-auto lg:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-xl bg-white px-4 text-sm font-bold shadow-sm">Menu <span aria-hidden="true" class="ml-2 text-lg leading-none">☰</span></summary>
        <nav aria-label="Mobilní navigace" class="absolute right-0 top-14 z-50 w-[min(24rem,calc(100vw-2.5rem))] rounded-2xl border border-ink/10 bg-white p-3 shadow-lift">
          <a href={withBase('/')} class="block rounded-xl px-4 py-3 font-bold no-underline hover:bg-mist hover:text-brand">Úvodní stránka</a>
          {navigation.map((group) => <details class="border-t border-ink/10 py-1"><summary class="flex cursor-pointer list-none items-center justify-between rounded-xl px-4 py-3 font-bold hover:bg-mist hover:text-brand">{group.label}<span aria-hidden="true">⌄</span></summary><div class="pb-2 pl-3">{group.items.map((item) => <a href={withBase(item.href)} class="block rounded-xl px-4 py-2.5 text-sm font-semibold no-underline hover:bg-mist hover:text-brand">{item.label}</a>)}</div></details>)}
          <a href={withBase('/kontakt/')} class="block rounded-xl px-4 py-3 font-bold no-underline hover:bg-mist hover:text-brand">Kontakty</a>
        </nav>
      </details>
      <a href={withBase('/kontakt/')} class="hidden text-sm font-bold text-brand no-underline hover:text-night sm:inline-block lg:hidden">Kontakty</a>
    </div>
  </div>
</header>
