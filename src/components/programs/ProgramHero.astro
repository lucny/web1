---
import { withBase } from '../../lib/content';
import AttachmentLink from '../content/AttachmentLink.astro';

interface Program {
  code: string;
  title: string;
  form: string;
  capacity: number;
  description: string;
  heroImage?: string;
}

interface Props {
  accent: string;
  program: Program;
  tagline?: string;
  applicantHref: string;
  studyPlanDocument?: DocumentRef;
  applicantDocument?: DocumentRef;
}

interface DocumentRef {
  file: string;
  title: string;
  description: string;
}

const { accent, program, tagline, applicantHref, studyPlanDocument, applicantDocument } = Astro.props as Props;
const links = [
  { label: 'Školní vzdělávací plán', href: '/dokumenty/', document: studyPlanDocument },
  { label: 'Průběh studia', href: '#obor-content' },
  { label: 'Přijímací řízení', href: '/uchazeci/' },
  { label: 'Informace pro uchazeče', href: applicantHref, document: applicantDocument }
];
---

<section class="container-page pb-10 sm:pb-14">
  <div class="overflow-hidden rounded-2xl shadow-lift" style={`background-color: ${accent}`}>
    <div class="relative aspect-[1600/600] min-h-[15rem]" style={`background-color: ${accent}`}>
      {program.heroImage && <img src={program.heroImage} alt={program.title} class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />}
      <div class="absolute inset-0" style={`background-color: color-mix(in srgb, ${accent} 35%, transparent)`}></div>
    </div>
    <div class="px-6 py-8 text-night sm:px-10 sm:py-10 lg:px-14 lg:py-12" style={`background-color: ${accent}`}>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-night/70">{program.form}</p>
      <h1 class="mt-3 text-4xl font-black uppercase tracking-tight text-white sm:text-5xl">{program.code} {program.title}</h1>
      {tagline && <p class="mt-3 text-lg font-bold text-white sm:text-2xl">{tagline}</p>}
      <p class="mt-4 max-w-4xl text-base leading-7 text-night/80 sm:text-lg">{program.description}</p>
      <p class="mt-6 text-xl font-black text-white sm:text-2xl">Přijímáme {program.capacity} žáků</p>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {links.map((link) => link.document ? <AttachmentLink label={link.label} url={link.document.file} description={link.document.description} class="flex min-h-14 items-center justify-center rounded-xl border border-white/25 bg-white/20 px-4 py-3 text-center text-sm font-bold text-night no-underline transition hover:-translate-y-0.5 hover:bg-white hover:shadow-soft">{link.label}</AttachmentLink> : <a href={withBase(link.href)} class="flex min-h-14 items-center justify-center rounded-xl border border-white/25 bg-white/20 px-4 py-3 text-center text-sm font-bold text-night no-underline transition hover:-translate-y-0.5 hover:bg-white hover:shadow-soft">{link.label}</a>)}
      </div>
    </div>
  </div>
</section>
