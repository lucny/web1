---
import type { CollectionEntry } from 'astro:content';
import { entries, formatDate, withBase } from '../../lib/content';
import GalleryLightbox from '../GalleryLightbox.astro';
import ArticleHero from './ArticleHero.astro';

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const galleries = await entries('galleries');
const gallery = article.data.gallery ? galleries.find((item) => item.id === article.data.gallery) : undefined;
---

<article data-pagefind-body>
  <ArticleHero article={article} />
  <span class="sr-only" data-pagefind-filter="typ">Aktualita</span>
  {article.data.programs.map((program) => <span class="sr-only" data-pagefind-filter="obor">{program}</span>)}
  {article.data.categories.map((category) => <span class="sr-only" data-pagefind-filter="rubrika">{category}</span>)}
  {article.data.tags.map((tag) => <span class="sr-only" data-pagefind-filter="stitek">{tag}</span>)}
  <div class="container-page pb-12 sm:pb-16">
    <div class="flex flex-col gap-3 border-y border-ink/10 py-4 text-sm text-ink/75 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="font-semibold text-ink">{article.data.author}</span>
        <span aria-hidden="true" class="text-ink/35">·</span>
        <time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt, { day: 'numeric', month: 'numeric', year: 'numeric' })}</time>
        {article.data.updatedAt && <><span aria-hidden="true" class="text-ink/35">·</span><span class="text-xs text-ink/60">Upraveno {formatDate(article.data.updatedAt, { day: 'numeric', month: 'numeric', year: 'numeric' })}</span></>}
      </div>
      <div class="flex flex-wrap gap-1.5 lg:justify-end">
        {article.data.categories.length > 0 ? article.data.categories.map((category) => <span class="rounded-sm border border-ink/10 bg-mist px-2 py-1 text-xs font-semibold text-brand">{category}</span>) : <span class="rounded-sm border border-ink/10 bg-mist px-2 py-1 text-xs font-semibold text-brand">Aktualita</span>}
      </div>
    </div>
    <div class="prose-school article-body-columns !max-w-none mt-10"><slot /></div>
    {gallery && <section class="article-wide-section mt-12 border-t border-ink/10 pt-10" aria-labelledby={'article-gallery-' + article.id}>
      <p class="eyebrow">Fotografie</p>
      <h2 id={'article-gallery-' + article.id} class="mt-2 text-2xl">{gallery.data.title}</h2>
      <p class="mt-3 max-w-3xl leading-7 text-ink/70">{gallery.data.description}</p>
      <div class="mt-6"><GalleryLightbox photos={gallery.data.photos} title={gallery.data.title} /></div>
    </section>}
    {article.data.attachments.length > 0 && <section class="article-wide-section mx-auto mt-10 max-w-3xl rounded-2xl bg-mist p-6">
      <h2 class="text-xl">Přílohy</h2>
      <ul>{article.data.attachments.map((attachment) => <li><a href={withBase(attachment.url)}>{attachment.label}</a></li>)}</ul>
    </section>}
  </div>
</article>
