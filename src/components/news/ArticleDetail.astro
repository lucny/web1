---
import type { CollectionEntry } from 'astro:content';
import { formatDate, withBase } from '../../lib/content';
import ArticleHero from './ArticleHero.astro';

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
---

<article data-pagefind-body>
  <ArticleHero article={article} />
  <span class="sr-only" data-pagefind-filter="typ">Aktualita</span>
  {article.data.programs.map((program) => <span class="sr-only" data-pagefind-filter="obor">{program}</span>)}
  {article.data.categories.map((category) => <span class="sr-only" data-pagefind-filter="rubrika">{category}</span>)}
  {article.data.tags.map((tag) => <span class="sr-only" data-pagefind-filter="stitek">{tag}</span>)}
  <div class="container-page pb-12 sm:pb-16">
    <div class="mx-auto max-w-3xl">
      <div class="grid gap-5 border-y border-ink/10 py-5 sm:grid-cols-[1.35fr_.8fr_1fr] sm:gap-6">
        <div>
          <p class="eyebrow">Rubrika</p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {article.data.categories.length > 0 ? article.data.categories.map((category) => <span class="rounded-sm border border-ink/10 bg-mist px-2 py-1 text-xs font-semibold text-brand">{category}</span>) : <span class="text-sm text-ink/70">Aktualita</span>}
          </div>
        </div>
        <div>
          <p class="eyebrow">Vydáno</p>
          <time class="mt-2 block text-sm font-semibold text-ink/80" datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time>
        </div>
        <div>
          <p class="eyebrow">Autor</p>
          <p class="mt-2 text-sm font-semibold text-ink/80">{article.data.author}</p>
          {article.data.updatedAt && <p class="mt-1 text-xs text-ink/60">Upraveno {formatDate(article.data.updatedAt)}</p>}
        </div>
      </div>
      <div class="prose-school mt-10"><slot /></div>
      {article.data.attachments.length > 0 && <section class="mx-auto mt-10 rounded-2xl bg-mist p-6">
        <h2 class="text-xl">Přílohy</h2>
        <ul>{article.data.attachments.map((attachment) => <li><a href={withBase(attachment.url)}>{attachment.label}</a></li>)}</ul>
      </section>}
    </div>
  </div>
</article>
