---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  accent?: string;
  image?: string;
}

const { eyebrow, title, description, accent = '#59BDDC', image } = Astro.props;
---

<section class="page-hero container-page py-8 sm:py-10" style={`--page-hero-accent:${accent}`}>
  <div class="relative isolate overflow-hidden rounded-[2rem] bg-night px-6 py-8 text-white shadow-lift sm:px-10 sm:py-10 lg:px-14 lg:py-12">
    {image && <img src={image} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-35" loading="lazy" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-night via-night/90 to-night/50"></div>
    <div class="relative z-10 max-w-4xl">
      <p class="eyebrow !text-[var(--page-hero-accent)]">{eyebrow}</p>
      <h1 class="mt-3 max-w-4xl text-white">{title}</h1>
      {description && <p class="mt-5 max-w-3xl text-lg leading-8 text-white/80 sm:text-xl">{description}</p>}
    </div>
    <div class="page-hero-art" aria-hidden="true"><span></span><span></span><span></span></div>
  </div>
</section>
