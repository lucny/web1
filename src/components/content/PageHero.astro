---
import { withBase } from '../../lib/content';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  accent?: string;
  image?: string;
  icon?: string;
  iconAlt?: string;
  iconBackground?: string;
  decorativeArt?: boolean;
}

const { eyebrow, title, description, accent = '#59BDDC', image, icon, iconAlt = '', iconBackground = '#001731', decorativeArt = true } = Astro.props;
---

<section class="page-hero container-page py-8 sm:py-10" style={`--page-hero-accent:${accent}`}>
  <div class:list={['relative isolate overflow-hidden rounded-2xl px-6 py-8 text-white shadow-lift sm:px-10 sm:py-10 lg:px-14 lg:py-12', icon ? 'page-hero-icon-layout' : 'bg-night']} style={icon ? `background-color:${iconBackground}` : undefined}>
    {image && <img src={image} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-35" loading="lazy" />}
    {!icon && <div class="absolute inset-0 -z-10 bg-gradient-to-r from-night via-night/90 to-night/50"></div>}
    <div class:list={['relative z-10', icon ? 'max-w-[76%] lg:max-w-[68%]' : 'max-w-4xl']}>
      <p class="eyebrow !text-[var(--page-hero-accent)]">{eyebrow}</p>
      <h1 class="mt-3 max-w-4xl text-white">{title}</h1>
      {description && <p class="mt-5 max-w-3xl text-lg leading-8 text-white/80 sm:text-xl">{description}</p>}
    </div>
    {icon ? <div class="page-hero-icon" aria-hidden="true"><img src={withBase(icon)} alt={iconAlt} /></div> : decorativeArt && <div class="page-hero-art" aria-hidden="true"><span></span><span></span><span></span></div>}
  </div>
</section>
