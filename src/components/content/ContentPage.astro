---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentRenderer from './ContentRenderer.astro';
import PageHero from './PageHero.astro';

interface Props {
  page: any;
  heroIcon?: string;
  accent?: string;
  eyebrow?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { page, heroIcon, accent = '#59BDDC', eyebrow, breadcrumbs = [] } = Astro.props;
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description} seo={page.data.seo} breadcrumbs={breadcrumbs}>
  <PageHero eyebrow={eyebrow ?? page.data.eyebrow ?? 'Škola'} title={page.data.title} description={page.data.highlight ?? page.data.description} accent={accent} icon={heroIcon} iconBackground="#001731" />
  <article class="container-page pb-14 sm:pb-20" data-pagefind-body>
    <span class="sr-only" data-pagefind-filter="typ">Stránka</span>
    <div class="mt-10"><ContentRenderer blocks={page.data.contentBlocks}><Content /></ContentRenderer></div>
  </article>
</BaseLayout>
