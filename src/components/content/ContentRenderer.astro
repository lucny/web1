---
import GalleryLightbox from '../GalleryLightbox.astro';
import ArticleSection from '../news/ArticleSection.astro';
import PersonCard from '../people/PersonCard.astro';
import AttachmentList from './AttachmentList.astro';
import { entries, withBase } from '../../lib/content';

type TextItem = { title: string; text: string };
type TableRow = string[] | { cells: string[] };
type Block =
  | { type: 'heading'; level?: 'h2' | 'h3'; text: string }
  | { type: 'text'; title?: string; text: string }
  | { type: 'image'; image: string; alt: string; caption?: string }
  | { type: 'youtube'; url: string; title?: string }
  | { type: 'audio'; src: string; title?: string }
  | { type: 'table'; caption?: string; headers: string[]; rows: TableRow[] }
  | { type: 'notice'; title: string; text: string }
  | { type: 'cta'; title: string; text: string; label: string; href: string }
  | { type: 'columns' | 'twoColumns' | 'threeColumns'; items: TextItem[] }
  | { type: 'gallery'; gallery: string }
  | { type: 'documents'; documents: string[] }
  | { type: 'articles'; articles: string[] }
  | { type: 'people'; people: string[] }
  | { type: 'downloads'; title?: string; items: { label: string; url: string; description?: string }[] }
  | { type: 'faq'; items: { question: string; answer: string }[] };

const { blocks = [], legacyClass = 'prose-school' } = Astro.props as { blocks?: Block[]; legacyClass?: string };
const [galleries, documents, articles, people] = await Promise.all([
  entries('galleries'), entries('documents'), entries('articles'), entries('people')
]);
const selected = <T extends { id: string }>(items: T[], ids: string[]) => items.filter((item) => ids.includes(item.id));

function youtubeEmbedUrl(value: string) {
  try {
    const url = new URL(value);
    const host = url.hostname.replace(/^www\./, '');
    if (host === 'youtu.be') return `https://www.youtube-nocookie.com/embed/${url.pathname.slice(1)}`;
    if (host === 'youtube.com' || host === 'm.youtube.com') {
      const id = url.pathname.startsWith('/embed/') ? url.pathname.split('/')[2] : url.searchParams.get('v');
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : undefined;
    }
  } catch {
    return undefined;
  }
  return undefined;
}

function tableCells(row: TableRow) {
  return Array.isArray(row) ? row : row.cells;
}

const renderLegacyContent = blocks.length === 0;
---

{renderLegacyContent ? (legacyClass ? <div class={legacyClass}><slot /></div> : <slot />) :
  blocks.map((block) => {
    if (block.type === 'heading') {
      return block.level === 'h3' ? <h3 class="content-block-heading mt-10 text-xl sm:text-2xl">{block.text}</h3> : <h2 class="content-block-heading mt-10 text-2xl sm:text-3xl">{block.text}</h2>;
    }
    if (block.type === 'text') return <section class="content-block-text my-8 max-w-3xl">{block.title && <h2 class="mb-4 text-2xl sm:text-3xl">{block.title}</h2>}<div class="space-y-4 whitespace-pre-line text-base leading-8 text-ink/85 sm:text-lg">{block.text}</div></section>;
    if (block.type === 'image') return <figure class="my-10"><img src={withBase(block.image)} alt={block.alt} class="max-h-[42rem] w-full rounded-3xl object-cover shadow-soft" loading="lazy" />{block.caption && <figcaption class="mt-3 text-sm leading-6 text-ink/70">{block.caption}</figcaption>}</figure>;
    if (block.type === 'youtube') {
      const embed = youtubeEmbedUrl(block.url);
      return embed ? <figure class="my-10"><iframe class="aspect-video w-full rounded-2xl border-0 bg-night shadow-soft" src={embed} title={block.title ?? 'Video na YouTube'} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>{block.title && <figcaption class="mt-3 text-sm leading-6 text-ink/70">{block.title}</figcaption>}</figure> : <p class="my-8"><a href={block.url} rel="noopener">Otevřít video na YouTube</a></p>;
    }
    if (block.type === 'audio') return <figure class="my-8 rounded-2xl bg-mist p-5">{block.title && <figcaption class="mb-3 font-bold text-night">{block.title}</figcaption>}<audio class="w-full" controls preload="metadata" src={withBase(block.src)}>Váš prohlížeč nepodporuje přehrávání zvuku.</audio></figure>;
    if (block.type === 'table') return <div class="my-10 overflow-x-auto rounded-2xl border border-ink/10 shadow-soft"><table class="my-0 w-full min-w-[32rem] border-collapse text-left text-sm"><caption class="border-b border-ink/10 bg-mist px-4 py-3 text-left font-bold text-night">{block.caption}</caption><thead><tr>{block.headers.map((header) => <th class="border border-ink/15 bg-mist px-3 py-3 font-bold text-night">{header}</th>)}</tr></thead><tbody>{block.rows.map((row) => <tr>{tableCells(row).map((cell) => <td class="border border-ink/15 px-3 py-3 align-top">{cell}</td>)}</tr>)}</tbody></table></div>;
    if (block.type === 'notice') return <aside class="info-panel my-10 border-l-4 border-l-school-lime"><h2 class="text-xl">{block.title}</h2><p class="mt-2 whitespace-pre-line leading-7">{block.text}</p></aside>;
    if (block.type === 'cta') return <section class="my-10 overflow-hidden rounded-3xl bg-night p-7 text-white shadow-lift sm:p-9"><p class="section-label !text-school-cyan">Důležitý odkaz</p><h2 class="mt-3 text-2xl text-white">{block.title}</h2><p class="mt-3 max-w-2xl whitespace-pre-line leading-7 text-white/75">{block.text}</p><a class="button-primary mt-6 !bg-accent !text-night hover:!bg-school-cyan" href={withBase(block.href)}>{block.label}</a></section>;
    if (block.type === 'columns' || block.type === 'twoColumns' || block.type === 'threeColumns') return <section class:list={["my-10 grid gap-4", block.type === 'threeColumns' ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
      {block.items.map((item) => <div class="info-panel"><h2 class="text-xl">{item.title}</h2><p class="mt-2 whitespace-pre-line leading-7">{item.text}</p></div>)}
    </section>;
    if (block.type === 'gallery') {
      const gallery = galleries.find((item) => item.id === block.gallery);
      return gallery && <section class="my-10"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="section-label">Galerie</p><h2 class="mt-2 text-2xl">{gallery.data.title}</h2><p class="mt-2 max-w-3xl leading-7 text-ink/75">{gallery.data.description}</p></div><a class="button-secondary" href={withBase(`/galerie/${gallery.id}/`)}>Celá galerie</a></div><div class="mt-6"><GalleryLightbox photos={gallery.data.photos} title={gallery.data.title} /></div></section>;
    }
    if (block.type === 'documents') {
      const items = selected(documents, block.documents);
      return items.length > 0 && <section class="my-10"><p class="section-label">Ke stažení</p><h2 class="mt-2 text-2xl">Dokumenty</h2><ul class="mt-5 grid gap-3">{items.map((item) => <li><a class="card block border-l-4 border-l-school-cyan p-5 no-underline hover:shadow-soft" href={withBase(`/dokumenty/${item.id}/`)}><strong>{item.data.title}</strong><span class="mt-1 block text-sm leading-6 text-ink/70">{item.data.description}</span></a></li>)}</ul></section>;
    }
    if (block.type === 'articles') {
      const items = selected(articles, block.articles);
      return items.length > 0 && <ArticleSection articles={items} eyebrow="Související" title="Aktuality" variant="compact" />;
    }
    if (block.type === 'people') {
      const items = selected(people, block.people);
      return items.length > 0 && <section class="my-10"><p class="section-label">Kontakty</p><h2 class="mt-2 text-2xl">Na koho se obrátit</h2><div class="mt-5 grid gap-4 sm:grid-cols-2">{items.map((item) => <PersonCard person={item} variant="compact" showPhoto={false} showPhone showWorkplace interactive={false} />)}</div></section>;
    }
    if (block.type === 'downloads') return <AttachmentList attachments={block.items} title={block.title ?? 'Přílohy ke stažení'} class="my-10" />;
    if (block.type === 'faq') return <section class="my-10"><p class="section-label">Praktické informace</p><h2 class="mt-3">Časté otázky</h2><div class="mt-4 divide-y divide-ink/15 overflow-hidden rounded-2xl border border-ink/15 bg-white shadow-soft">{block.items.map((item) => <details class="p-5"><summary class="cursor-pointer font-bold">{item.question}</summary><p class="mt-3 whitespace-pre-line leading-7">{item.answer}</p></details>)}</div></section>;
    return null;
  })
}
