---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries } from '../../lib/content';
const people = await entries('people');
---
<BaseLayout title="Kontakty" description="Vedení školy, koordinátoři oborů a kontaktní údaje SŠPU Opava."><section class="container-page py-14 sm:py-20" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Kontakty</span><p class="eyebrow">Lidé a kontakty</p><h1 class="mt-3">Máte otázku? Obraťte se na správného člověka.</h1><div class="mt-10 grid gap-6 lg:grid-cols-[.75fr_1.25fr]"><aside class="rounded-3xl bg-night p-7 text-white"><h2 class="text-2xl text-white">SŠPU Opava</h2><address class="mt-5 not-italic leading-8 text-white/80">Praskova 399/8<br />746 01 Opava<br /><a class="font-bold text-white" href="tel:+420553621580">+420 553 621 580</a><br /><a class="font-bold text-white" href="mailto:sspu@sspu-opava.cz">sspu@sspu-opava.cz</a></address><p class="mt-8 text-sm leading-6 text-white/65">IČ: 47813121 · IZO: 000601896<br />Zřizovatel: Moravskoslezský kraj</p></aside><div class="grid gap-4 sm:grid-cols-2">{people.map((person) => <article class="card p-6"><p class="text-xs font-bold uppercase tracking-wide text-brand">{person.data.department}</p><h2 class="mt-2 text-2xl"><a class="no-underline hover:text-brand" href={`/kontakt/${person.id}/`}>{person.data.name}</a></h2><p class="mt-2 font-semibold text-ink/70">{person.data.role}</p><a class="mt-5 inline-block font-bold text-brand" href={`mailto:${person.data.email}`}>{person.data.email}</a>{person.data.phone && <a class="mt-1 block font-bold text-brand" href={`tel:${person.data.phone.replaceAll(' ', '')}`}>{person.data.phone}</a>}</article>)}</div></div></section></BaseLayout>
