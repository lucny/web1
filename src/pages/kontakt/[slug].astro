---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries } from '../../lib/content';
export async function getStaticPaths() { return (await entries('people')).map((person) => ({ params: { slug: person.id }, props: { person } })); }
const { person } = Astro.props; const schema = { '@context': 'https://schema.org', '@type': 'Person', name: person.data.name, jobTitle: person.data.role, email: person.data.email, worksFor: { '@type': 'EducationalOrganization', name: 'SŠPU Opava' } };
---
<BaseLayout title={person.data.name} description={`${person.data.role}, SŠPU Opava`} breadcrumbs={[{ label: 'Kontakty', href: '/kontakt/' }, { label: person.data.name }]} schema={schema}><article class="container-page py-12 sm:py-16" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Osoba</span>{person.data.programs.map((program) => <span class="sr-only" data-pagefind-filter="obor">{program}</span>)}<div class="mx-auto max-w-2xl rounded-3xl bg-mist p-7 sm:p-10"><p class="eyebrow">{person.data.department}</p><h1 class="mt-3">{person.data.name}</h1><p class="mt-3 text-xl text-ink/75">{person.data.role}</p><p class="mt-8 leading-8">{person.data.profile}</p><dl class="mt-8 grid gap-4 border-t border-ink/15 pt-7">{person.data.phone && <div><dt class="text-sm font-bold text-ink/65">Telefon</dt><dd><a href={`tel:${person.data.phone.replaceAll(' ', '')}`}>{person.data.phone}</a></dd></div>}<div><dt class="text-sm font-bold text-ink/65">E-mail</dt><dd><a href={`mailto:${person.data.email}`}>{person.data.email}</a></dd></div></dl></div></article></BaseLayout>
