---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries } from '../../lib/content';
import PageHero from '../../components/content/PageHero.astro';
export async function getStaticPaths() { return (await entries('people')).filter((person) => person.data.contactVisible).map((person) => ({ params: { slug: person.id }, props: { person } })); }
const { person } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'Person', name: person.data.name, jobTitle: person.data.role, email: person.data.email, worksFor: { '@type': 'EducationalOrganization', name: 'SŠPU Opava' } };
---
<BaseLayout title={person.data.name} description={`${person.data.role}, SŠPU Opava`} seo={person.data.seo} breadcrumbs={[{ label: 'Kontakty', href: '/kontakt/' }, { label: person.data.name }]} schema={schema}>
  <PageHero eyebrow={person.data.department} title={person.data.name} description={person.data.role} accent="#ECAFAC" /><article class="container-page pb-12 sm:pb-16" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Osoba</span>{person.data.programs.map((program) => <span class="sr-only" data-pagefind-filter="obor">{program}</span>)}<div class="mx-auto max-w-2xl rounded-3xl bg-mist p-7 sm:p-10"><p class="leading-8">{person.data.profile}</p><dl class="mt-8 grid gap-4 border-t border-ink/15 pt-7">{person.data.phone && <div><dt class="text-sm font-bold text-ink/65">Telefon</dt><dd><a href={`tel:${person.data.phone.replaceAll(' ', '')}`}>{person.data.phone}</a></dd></div>}<div><dt class="text-sm font-bold text-ink/65">E-mail</dt><dd><a href={`mailto:${person.data.email}`}>{person.data.email}</a></dd></div></dl></div></article>
</BaseLayout>
