---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { entries, withBase } from '../../lib/content';
export async function getStaticPaths() { return (await entries('programs')).map((program) => ({ params: { slug: program.id }, props: { program } })); }
const { program } = Astro.props;
const { Content } = await render(program);
const [articles, galleries, people] = await Promise.all([entries('articles'), entries('galleries'), entries('people')]);
const relatedArticles = articles.filter((article) => article.data.programs.includes(program.id)).slice(0, 3);
const relatedGalleries = galleries.filter((gallery) => gallery.data.programs.includes(program.id));
const advisors = people.filter((person) => person.data.programs.includes(program.id) && person.data.contactVisible);
---
<BaseLayout title={program.data.title} description={program.data.description} seo={program.data.seo} breadcrumbs={[{ label: 'Obory a studium', href: '/obory/' }, { label: program.data.title }]} schema={{ '@context': 'https://schema.org', '@type': 'Course', name: program.data.title, description: program.data.description, provider: { '@type': 'EducationalOrganization', name: 'SŠPU Opava' } }}>
  <section class="container-page py-12 sm:py-16" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Obor</span><span class="sr-only" data-pagefind-filter="obor">{program.data.title}</span><div class="grid gap-10 lg:grid-cols-[1.05fr_.95fr]"><div><p class="eyebrow">{program.data.code} · {program.data.form}</p><h1 class="mt-3">{program.data.title}</h1><p class="mt-6 text-xl leading-8 text-ink/80">{program.data.description}</p><div class="mt-8 flex flex-wrap gap-3"><a href={withBase('/uchazeci/')} class="button-primary">Chci se přihlásit</a><a href="#kontakt-oboru" class="button-secondary">Kontakt k oboru</a></div></div>{program.data.heroImage && <img src={withBase(program.data.heroImage)} alt="" class="h-full min-h-72 w-full rounded-3xl object-cover shadow-lift" />}</div><div class="mt-14 grid gap-10 lg:grid-cols-[1.1fr_.9fr]"><article class="prose-school"><Content /></article><aside class="card h-fit p-6"><h2 class="text-2xl">Co vás čeká</h2><ul class="mt-5 space-y-3">{program.data.highlights.map((highlight) => <li class="flex gap-3"><span class="mt-1 font-bold text-brand" aria-hidden="true">✓</span><span>{highlight}</span></li>)}</ul><h3 class="mt-8 text-lg">Kam můžete dál</h3><p class="mt-3 text-sm leading-6 text-ink/70">{program.data.careers.join(' · ')}</p></aside></div></section>
  {relatedArticles.length > 0 && <section class="bg-mist py-16"><div class="container-page"><p class="eyebrow">Z oboru</p><h2 class="mt-2">Aktuality a projekty</h2><div class="mt-7 grid gap-6 lg:grid-cols-3">{relatedArticles.map((article) => <ArticleCard article={article} />)}</div></div></section>}
  <section id="kontakt-oboru" class="container-page py-16"><div class="grid gap-8 lg:grid-cols-2"><div><p class="eyebrow">Kontakt k oboru</p><h2 class="mt-2">Ptejte se konkrétně.</h2><p class="mt-4 max-w-xl leading-7 text-ink/75">Rádi vám pomůžeme s volbou oboru, přijímacím řízením i návštěvou školy.</p></div><div class="grid gap-4">{advisors.map((person) => <article class="card p-5"><h3 class="text-xl">{person.data.name}</h3><p class="mt-1 text-sm font-bold text-brand">{person.data.role}</p><a class="mt-3 inline-block" href={`mailto:${person.data.email}`}>{person.data.email}</a></article>)}</div></div>{relatedGalleries.length > 0 && <p class="mt-10 text-sm text-ink/70">Související galerie: {relatedGalleries.map((gallery) => <a class="font-bold text-brand" href={withBase(`/galerie/${gallery.id}/`)}>{gallery.data.title}</a>)}</p>}</section>
</BaseLayout>
