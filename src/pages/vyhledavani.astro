---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Vyhledávání" description="Fulltextové vyhledávání napříč obsahem SŠPU Opava."><section class="container-page py-14 sm:py-20"><p class="eyebrow">Vyhledávání</p><h1 class="mt-3">Najděte, co potřebujete.</h1><p class="prose-school mt-5">Vyhledáváme ve stránkách, aktualitách, oborech, galeriích, dokumentech, událostech i kontaktech.</p><form class="mt-9 grid gap-4 rounded-3xl bg-mist p-5 sm:grid-cols-[1fr_12rem_auto]" data-search-form><label class="grid gap-1 font-bold" for="site-search">Hledaný výraz<input id="site-search" name="query" class="min-h-12 rounded-xl border border-ink/15 bg-white px-4 font-normal" placeholder="Např. přijímačky, CNC, Erasmus…" autocomplete="off" /></label><label class="grid gap-1 font-bold" for="type-filter">Typ obsahu<select id="type-filter" name="type" class="min-h-12 rounded-xl border border-ink/15 bg-white px-4 font-normal"><option value="">Všechen obsah</option><option>Aktualita</option><option>Obor</option><option>Galerie</option><option>Dokument</option><option>Událost</option><option>Osoba</option><option>Stránka</option></select></label><button class="button-primary self-end" type="submit">Hledat</button></form><p class="mt-6 text-sm text-ink/70" aria-live="polite" data-search-status>Začněte psát hledaný výraz.</p><div class="mt-6 grid gap-4" data-search-results></div><noscript><p class="mt-8 rounded-xl bg-mist p-5">Pro interaktivní fulltext je potřeba JavaScript. Obsah zůstává dostupný v hlavní navigaci a přes jednotlivé přehledy.</p></noscript></section></BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('#site-search');
  const type = document.querySelector<HTMLSelectElement>('#type-filter');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const escape = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character] || character));
  type SearchResult = { title: string; url: string; type: string; excerpt?: string };
  type ContentItem = SearchResult & { description?: string; text?: string; metadata?: string };

  const normalized = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('cs-CZ');
  const plainText = (value = '') => value.replace(/!?(?:\[[^\]]*\]\([^)]*\)|[`#>*_~])/g, ' ').replace(/\s+/g, ' ').trim();
  const makeExcerpt = (value = '') => {
    const text = plainText(value);
    return text.length > 220 ? `${text.slice(0, 217).trimEnd()}…` : text;
  };
  const render = (items: SearchResult[]) => {
    if (!results) return;
    results.innerHTML = items.length
      ? items.map((item) => `<article class="card p-6"><p class="text-xs font-bold uppercase tracking-wide text-brand">${escape(item.type || 'Obsah')}</p><h2 class="mt-2 text-2xl"><a class="no-underline hover:text-brand" href="${escape(item.url)}">${escape(item.title || 'Bez názvu')}</a></h2><p class="mt-3 leading-7 text-ink/75">${item.excerpt || ''}</p></article>`).join('')
      : '<p class="rounded-2xl bg-mist p-6">Zkuste jiný výraz nebo zrušte filtr typu obsahu.</p>';
  };

  async function search() {
    const query = input?.value.trim(); if (!query || !results || !status) return;
    status.textContent = 'Hledám…'; results.innerHTML = '';
    try {
      const pagefindPath = '/pagefind/pagefind.js';
      const pagefind = await import(/* @vite-ignore */ pagefindPath);
      const searchResult = await pagefind.search(query, { filters: type?.value ? { typ: type.value } : {} });
      const data = await Promise.all(searchResult.results.slice(0, 20).map((result: { data: () => Promise<{ url: string; meta: { title?: string; typ?: string }; filters?: { typ?: string[] }; excerpt?: string }> }) => result.data()));
      status.textContent = `Nalezeno výsledků: ${searchResult.results.length}.`;
      render(data.map((item) => ({ title: item.meta.title || 'Bez názvu', url: item.url, type: item.meta.typ || item.filters?.typ?.[0] || 'Obsah', excerpt: item.excerpt })));
    } catch {
      try {
        const response = await fetch('/obsah.json');
        if (!response.ok) throw new Error('Nelze načíst vývojový index.');
        const index = await response.json() as { content: ContentItem[] };
        const needle = normalized(query);
        const data = index.content
          .filter((item) => !type?.value || item.type === type.value)
          .filter((item) => normalized([item.title, item.description, item.text, item.metadata].filter(Boolean).join(' ')).includes(needle))
          .slice(0, 20)
          .map((item) => ({ title: item.title, url: item.url, type: item.type, excerpt: makeExcerpt(item.description || item.text) }));
        status.textContent = `Nalezeno výsledků: ${data.length}.`;
        render(data);
      } catch {
        status.textContent = 'Vyhledávání se nepodařilo načíst. Obnovte prosím stránku nebo to zkuste později.';
      }
    }
  }
  form?.addEventListener('submit', (event) => { event.preventDefault(); search(); });
  const params = new URLSearchParams(location.search); if (params.get('q') && input) { input.value = params.get('q') || ''; search(); }
</script>
