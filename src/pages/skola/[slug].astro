---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentRenderer from '../../components/content/ContentRenderer.astro';
import PageHero from '../../components/content/PageHero.astro';
import { entries } from '../../lib/content';
export async function getStaticPaths() { return (await entries('pages')).filter((page) => !page.id.startsWith('dokumenty-')).map((page) => ({ params: { slug: page.id }, props: { page } })); }
const { page } = Astro.props;
const { Content } = await render(page);
const pageHeroIcons: Record<string, string> = {
  'studentsky-parlament': '/images/banners/studentsky-parlament.png',
  'umelecka-rada': '/images/banners/umelecka-rada.png'
};
const heroIcon = pageHeroIcons[page.id];
---
<BaseLayout title={page.data.title} description={page.data.description} seo={page.data.seo} breadcrumbs={[{ label: 'Škola', href: '/skola/o-skole/' }, { label: page.data.title }]}><PageHero eyebrow={page.data.eyebrow ?? 'Škola'} title={page.data.title} description={page.data.highlight} accent={heroIcon ? '#59BDDC' : '#1A4053'} icon={heroIcon} iconBackground="#001731" /><article class="container-page pb-14 sm:pb-20" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Stránka</span><div class="mt-10"><ContentRenderer blocks={page.data.contentBlocks}><Content /></ContentRenderer></div></article></BaseLayout>
