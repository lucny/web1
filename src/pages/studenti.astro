---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byId, entries } from '../lib/content';
const [page, documents] = await Promise.all([byId('pages', 'pro-studenty'), entries('documents')]);
if (!page) throw new Error('Chybí obsahová stránka pro studenty.'); const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description} breadcrumbs={[{ label: 'Pro studenty' }]}><section class="container-page py-14 sm:py-20" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Stránka</span><p class="eyebrow">{page.data.eyebrow}</p><h1 class="mt-3 max-w-4xl">{page.data.title}</h1><p class="mt-6 max-w-3xl text-xl leading-8 text-ink/80">{page.data.highlight}</p><div class="prose-school mt-8"><Content /></div><div class="mt-12 grid gap-4 md:grid-cols-2">{documents.filter((document) => document.data.pages.includes('pro-studenty')).map((document) => <a href={`/dokumenty/${document.id}/`} class="card p-6 no-underline hover:border-brand"><p class="text-sm font-bold text-brand">Dokument</p><h2 class="mt-2 text-2xl">{document.data.title}</h2><p class="mt-3 text-ink/70">{document.data.description}</p></a>)}</div></section></BaseLayout>
