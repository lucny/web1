---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byId, entries } from '../lib/content';
import PageHero from '../components/content/PageHero.astro';
import ContentRenderer from '../components/content/ContentRenderer.astro';
import AttachmentLink from '../components/content/AttachmentLink.astro';
import EventSection from '../components/events/EventSection.astro';
import { heroImages } from '../data/heroImages';
const [page, documents, events] = await Promise.all([byId('pages', 'pro-studenty'), entries('documents'), entries('events')]);
if (!page) throw new Error('Chybí obsahová stránka pro studenty.');
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description} seo={page.data.seo} breadcrumbs={[{ label: 'Pro studenty' }]}>
  <PageHero eyebrow={page.data.eyebrow ?? 'Pro studenty'} title={page.data.title} description={page.data.highlight} accent="#59BDDC" icon={heroImages.students} iconBackground="#001731" />
  <section class="container-page pb-10 sm:pb-14" data-pagefind-body>
    <span class="sr-only" data-pagefind-filter="typ">Stránka</span>
    <div class="mt-10"><ContentRenderer blocks={page.data.contentBlocks}><Content /></ContentRenderer></div>
    <section class="mt-14"><p class="section-label">Ke stažení</p><h2 class="mt-3">Dokumenty pro studenty</h2><div class="mt-6 grid gap-4 md:grid-cols-2">{documents.filter((document) => document.data.pages.includes('pro-studenty')).map((document) => <AttachmentLink label={document.data.title} url={document.data.file} description={document.data.description} class="card border-t-4 border-t-school-magenta p-6 no-underline transition hover:-translate-y-1 hover:shadow-soft"><p class="meta-label">Dokument</p><h3 class="mt-2 text-2xl text-night">{document.data.title}</h3><p class="mt-3 text-ink/70">{document.data.description}</p></AttachmentLink>)}</div></section>
  </section>
  <EventSection events={events} eyebrow="Pro studenty" title="Důležité termíny" variant="graduates" tags={['maturanti']} limit={4} from="now" background="mist" />
</BaseLayout>
