---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, formatDate } from '../../lib/content';
export async function getStaticPaths() { return (await entries('events')).map((event) => ({ params: { slug: event.id }, props: { event } })); }
const { event } = Astro.props; const schema = { '@context': 'https://schema.org', '@type': 'Event', name: event.data.title, description: event.data.description, startDate: event.data.start.toISOString(), endDate: event.data.end?.toISOString(), location: { '@type': 'Place', name: event.data.location }, organizer: { '@type': 'EducationalOrganization', name: 'SŠPU Opava' } };
---
<BaseLayout title={event.data.title} description={event.data.description} breadcrumbs={[{ label: 'Kalendář akcí', href: '/udalosti/' }, { label: event.data.title }]} schema={schema}><article class="container-page py-12 sm:py-16" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Událost</span>{event.data.programs.map((program) => <span class="sr-only" data-pagefind-filter="obor">{program}</span>)}<div class="mx-auto max-w-3xl"><p class="eyebrow">{event.data.type}</p><h1 class="mt-3">{event.data.title}</h1><p class="mt-6 text-xl leading-8 text-ink/80">{event.data.description}</p><dl class="mt-10 grid gap-5 rounded-3xl bg-mist p-6 sm:grid-cols-2"><div><dt class="font-bold text-ink/65">Začátek</dt><dd class="mt-1">{formatDate(event.data.start, { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</dd></div>{event.data.end && <div><dt class="font-bold text-ink/65">Konec</dt><dd class="mt-1">{formatDate(event.data.end, { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</dd></div>}<div><dt class="font-bold text-ink/65">Místo</dt><dd class="mt-1">{event.data.location}</dd></div></dl>{event.data.url && <a class="button-primary mt-8" href={event.data.url}>Více informací</a>}</div></article></BaseLayout>
