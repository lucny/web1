---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, formatDate, withBase } from '../../lib/content';
import PageHero from '../../components/content/PageHero.astro';
const events = (await entries('events')).sort((a, b) => Number(a.data.start) - Number(b.data.start));
---
<BaseLayout title="Kalendář akcí" description="Nejbližší akce SŠPU Opava: dny otevřených dveří, výstavy, školní termíny a setkání s praxí.">
  <PageHero eyebrow="Kalendář akcí" title="Co nás čeká v nejbližších měsících." description="Termíny pro uchazeče, školní setkání, výstavy i příležitosti potkat školu osobně." accent="#D0D543" />
  <section class="container-page pb-10 sm:pb-14" data-pagefind-body>
    <span class="sr-only" data-pagefind-filter="typ">Přehled událostí</span>
    <div class="mt-10 space-y-4">{events.map((event) => <article class="card grid gap-5 border-l-4 border-l-school-lime p-5 transition hover:shadow-soft sm:grid-cols-[7rem_1fr_auto] sm:items-center"><time class="rounded-2xl bg-mist p-4 text-center text-sm font-bold text-brand" datetime={event.data.start.toISOString()}>{formatDate(event.data.start, { day: 'numeric', month: 'long', year: 'numeric' })}<span class="mt-1 block text-xs text-ink/70">{formatDate(event.data.start, { hour: '2-digit', minute: '2-digit' })}</span></time><div><p class="meta-label">{event.data.type}</p><h2 class="mt-2 text-2xl"><a class="no-underline hover:text-school-magenta" href={withBase(`/udalosti/${event.id}/`)}>{event.data.title}</a></h2><p class="mt-2 leading-7 text-ink/70">{event.data.description}</p><p class="mt-2 text-sm font-bold">{event.data.location}</p></div><a class="button-secondary" href={withBase(`/udalosti/${event.id}/`)}>Detail</a></article>)}</div>
  </section>
</BaseLayout>
