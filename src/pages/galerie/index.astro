---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, formatDate } from '../../lib/content';
const galleries = await entries('galleries');
---
<BaseLayout title="Galerie" description="Škola obrazem: prostory SŠPU Opava, studentské práce, výstavy a školní život."><section class="container-page py-14 sm:py-20" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Přehled galerií</span><p class="eyebrow">Škola obrazem</p><h1 class="mt-3">Podívejte se, kde vznikají nápady.</h1><div class="mt-10 grid gap-6 md:grid-cols-2">{galleries.map((gallery) => <article class="group overflow-hidden rounded-3xl bg-night"><img src={gallery.data.cover} alt="" class="h-72 w-full object-cover opacity-85 transition duration-300 group-hover:scale-105 group-hover:opacity-100" loading="lazy"/><div class="p-6 text-white"><p class="text-sm font-bold text-accent">{formatDate(gallery.data.date)}</p><h2 class="mt-2 text-3xl text-white"><a href={`/galerie/${gallery.id}/`} class="no-underline">{gallery.data.title}</a></h2><p class="mt-3 leading-7 text-white/75">{gallery.data.description}</p><a class="mt-5 inline-flex font-bold text-white" href={`/galerie/${gallery.id}/`}>Otevřít galerii →</a></div></article>)}</div></section></BaseLayout>
