---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, formatDate, withBase } from '../../lib/content';
const galleries = await entries('galleries');
---
<BaseLayout title="Galerie" description="Škola obrazem: prostory SŠPU Opava, studentské práce, výstavy a školní život.">
  <section class="container-page py-10 sm:py-14" data-pagefind-body>
    <span class="sr-only" data-pagefind-filter="typ">Přehled galerií</span>
    <div class="page-intro max-w-5xl"><p class="eyebrow">Škola obrazem</p><h1 class="mt-3">Podívejte se, kde vznikají nápady.</h1><p class="prose-school mt-5">Prostory školy, práce studentů, výstavy i okamžiky ze společného školního života na jednom místě.</p></div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">{galleries.map((gallery) => <article class="group overflow-hidden rounded-3xl border border-ink/10 bg-night shadow-lift"><div class="overflow-hidden"><img src={withBase(gallery.data.cover)} alt="" class="h-72 w-full object-cover opacity-85 transition duration-500 group-hover:scale-105 group-hover:opacity-100" loading="lazy" /></div><div class="border-t-4 border-t-school-magenta p-6 text-white"><p class="meta-label !text-school-lime">{formatDate(gallery.data.date)}</p><h2 class="mt-2 text-3xl text-white"><a href={withBase(`/galerie/${gallery.id}/`)} class="no-underline">{gallery.data.title}</a></h2><p class="mt-3 leading-7 text-white/75">{gallery.data.description}</p><a class="mt-5 inline-flex font-bold text-white no-underline transition group-hover:text-school-cyan" href={withBase(`/galerie/${gallery.id}/`)}>Otevřít galerii <span aria-hidden="true" class="ml-2">→</span></a></div></article>)}</div>
  </section>
</BaseLayout>
