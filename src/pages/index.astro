---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsFilters from '../components/NewsFilters.astro';
import { entries, formatDate } from '../lib/content';
const [articles, programs, galleries, eventEntries] = await Promise.all([entries('articles'), entries('programs'), entries('galleries'), entries('events')]);
const events = eventEntries.filter((event) => event.data.start >= new Date('2026-08-20')).sort((a, b) => Number(a.data.start) - Number(b.data.start));
const categories = [...new Set(articles.flatMap((article) => article.data.categories))];
---
<BaseLayout title="SŠPU Opava" description="Technika, digitální svět a tvorba. Poznejte pět oborů Střední školy průmyslové a umělecké v Opavě.">
  <section class="overflow-hidden bg-night py-14 text-white sm:py-20">
    <div class="container-page grid items-end gap-10 lg:grid-cols-[1.2fr_.8fr]">
      <div><p class="eyebrow !text-accent">Střední škola průmyslová a umělecká</p><h1 class="mt-5 max-w-3xl text-white">Místo, kde se z nápadů stává dovednost.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-white/75">Od konstrukce a kódu po grafiku, produktový design a hračku. Učte se tvořit, přemýšlet a obstát v praxi.</p><div class="mt-8 flex flex-wrap gap-3"><a href="/obory/" class="button-primary !bg-accent !text-night hover:!bg-white">Prozkoumat obory</a><a href="/uchazeci/" class="button-secondary !border-white/25 !bg-transparent !text-white hover:!bg-white hover:!text-night">Jsem uchazeč</a></div></div>
      <aside class="rounded-3xl border border-white/15 bg-white/10 p-6 backdrop-blur"><p class="text-sm font-bold uppercase tracking-wider text-accent">Nepřehlédněte</p><h2 class="mt-3 text-2xl text-white">Zahájení školního roku 2026/2027</h2><p class="mt-3 leading-7 text-white/75">V úterý 1. září v 8:00. První ročníky začínají v aule, vyšší ročníky v kmenových učebnách.</p><a href="/aktuality/zahajeni-skolniho-roku-2026/" class="mt-5 inline-flex font-bold text-white">Praktické informace →</a></aside>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow">Studijní obory</p><h2 class="mt-2">Pět cest. Jedna škola.</h2></div><a class="font-bold text-brand" href="/obory/">Všechny obory →</a></div><div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">{programs.map((program, index) => <a href={`/obory/${program.id}/`} class="group rounded-2xl border border-ink/10 bg-white p-5 no-underline shadow-lift transition hover:-translate-y-1 hover:border-brand"><span class="text-sm font-bold text-brand">0{index + 1}</span><h3 class="mt-9 text-xl group-hover:text-brand">{program.data.title}</h3><p class="mt-3 text-sm leading-6 text-ink/70">{program.data.code}</p></a>)}</div></section>

  <section class="bg-mist py-16 sm:py-20"><div class="container-page"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow">Školní zpravodaj</p><h2 class="mt-2">Co se ve škole děje</h2></div><a class="button-secondary" href="/aktuality/">Všechny aktuality</a></div><NewsFilters categories={categories} programs={programs.map((program) => ({ id: program.id, title: program.data.title }))} /><div class="mt-7 grid gap-6 lg:grid-cols-3">{articles.slice(0, 6).map((article) => <ArticleCard article={article} />)}</div></div></section>

  <section class="container-page grid gap-8 py-16 lg:grid-cols-[1.15fr_.85fr]"><div><p class="eyebrow">Nadcházející</p><h2 class="mt-2">Kalendář, který dává smysl</h2><div class="mt-8 space-y-3">{events.slice(0, 3).map((event) => <article class="card flex gap-4 p-4 sm:p-5"><time class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-mist text-center text-xs font-bold text-brand" datetime={event.data.start.toISOString()}>{formatDate(event.data.start, { day: 'numeric', month: 'short' })}</time><div><p class="text-xs font-bold uppercase tracking-wide text-brand">{event.data.type}</p><h3 class="mt-1 text-lg"><a href={`/udalosti/${event.id}/`} class="no-underline hover:text-brand">{event.data.title}</a></h3><p class="mt-1 text-sm text-ink/70">{event.data.location}</p></div></article>)}</div><a href="/udalosti/" class="mt-6 inline-flex font-bold text-brand">Celý přehled akcí →</a></div><aside class="rounded-3xl bg-brand p-7 text-white"><p class="text-sm font-bold uppercase tracking-wider text-white/70">Pro uchazeče</p><h2 class="mt-4 text-3xl text-white">Nejlepší způsob, jak si vybrat? Přijít se podívat.</h2><p class="mt-4 leading-7 text-white/80">Seznamte se s ateliéry, dílnami, laboratořemi i lidmi, kteří budou u vašeho studia.</p><a href="/uchazeci/" class="button-primary mt-7 !bg-white !text-night hover:!bg-accent">Přijímací řízení</a></aside></section>

  <section class="bg-night py-16 text-white"><div class="container-page"><div class="flex items-end justify-between gap-5"><div><p class="eyebrow !text-accent">Škola obrazem</p><h2 class="mt-2 text-white">Prostor pro práci i nápady</h2></div><a class="font-bold text-white" href="/galerie/">Všechny galerie →</a></div><div class="mt-8 grid gap-5 md:grid-cols-2">{galleries.map((gallery) => <a href={`/galerie/${gallery.id}/`} class="group relative overflow-hidden rounded-3xl no-underline"><img src={gallery.data.cover} alt="" class="h-64 w-full object-cover opacity-80 transition duration-300 group-hover:scale-105 group-hover:opacity-100" loading="lazy"/><span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-night/90 px-6 pb-6 pt-20"><span class="text-sm font-bold text-accent">{formatDate(gallery.data.date)}</span><strong class="mt-1 block font-display text-2xl text-white">{gallery.data.title}</strong></span></a>)}</div></div></section>

  <section class="container-page py-16"><p class="eyebrow">Rychlý rozcestník</p><div class="mt-6 grid gap-4 md:grid-cols-3"><a href="/uchazeci/" class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Uchazeči</h2><p class="mt-3 leading-7 text-ink/70">Obory, přijímačky a dny otevřených dveří.</p></a><a href="/studenti/" class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Studenti a rodiče</h2><p class="mt-3 leading-7 text-ink/70">Dokumenty, podpora a školní systémy.</p></a><a href="/kontakt/" class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Veřejnost a partneři</h2><p class="mt-3 leading-7 text-ink/70">Kontakty, spolupráce a informace o škole.</p></a></div></section>
</BaseLayout>
