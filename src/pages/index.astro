---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsFilters from '../components/NewsFilters.astro';
import { entries, formatDate, withBase } from '../lib/content';
const [articles, programs, galleries, eventEntries] = await Promise.all([entries('articles'), entries('programs'), entries('galleries'), entries('events')]);
const events = eventEntries.filter((event) => event.data.start >= new Date('2026-08-20')).sort((a, b) => Number(a.data.start) - Number(b.data.start));
const categories = [...new Set(articles.flatMap((article) => article.data.categories))];
const programPalette = [
  { id: 'strojirenstvi', label: 'Strojírenství', color: '#1A4053', textColor: '#FFFFFF' },
  { id: 'informacni-technologie', label: 'Informační technologie', color: '#59BDDC', textColor: '#102A43' },
  { id: 'tvorba-hracek-a-hernich-predmetu', label: 'Design hraček', color: '#ECAFAC', textColor: '#102A43' },
  { id: 'prumyslovy-design', label: 'Průmyslový design', color: '#D0D543', textColor: '#102A43' },
  { id: 'graficky-design', label: 'Grafický design', color: '#C42079', textColor: '#FFFFFF' }
];
const programStrip = programPalette.flatMap((item) => {
  const program = programs.find((entry) => entry.id === item.id);
  return program ? [{ ...item, href: withBase(`/obory/${program.id}/`) }] : [];
});
const showcase = galleries.find((gallery) => gallery.id === 'studentske-prace') ?? galleries[0];
---
<BaseLayout title="SŠPU Opava" description="Technika, digitální svět a tvorba. Poznejte pět oborů Střední školy průmyslové a umělecké v Opavě.">
  <section aria-label="Úvodní banner" class="bg-paper py-5 sm:py-7">
    <div class="container-page">
      <article class="relative isolate min-h-[18rem] overflow-hidden rounded-3xl bg-night sm:min-h-[23rem]">
        {showcase && <img src={withBase(showcase.data.cover)} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-65" fetchpriority="high" />}
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-night via-night/65 to-night/10"></div>
        <div class="flex min-h-[18rem] max-w-3xl flex-col justify-end p-6 text-white sm:min-h-[23rem] sm:p-10 lg:p-12">
          <p class="eyebrow !text-accent">Studium 2026 / 2027</p>
          <h1 class="mt-3 max-w-2xl text-white">Kde se z nápadů stává dovednost.</h1>
          <p class="mt-4 max-w-xl text-base leading-7 text-white/80 sm:text-lg">Od konstrukce a kódu po grafiku, produktový design a hračku. Poznejte školu, ve které vznikají věci pro skutečný svět.</p>
          <div class="mt-6 flex flex-wrap gap-3"><a href={withBase('/obory/')} class="button-primary !bg-accent !text-night hover:!bg-white">Poznat obory</a><a href={withBase('/uchazeci/')} class="button-secondary !border-white/30 !bg-night/20 !text-white hover:!bg-white hover:!text-night">Informace pro uchazeče</a></div>
        </div>
        <p class="absolute bottom-5 right-6 text-xs font-bold uppercase tracking-[.18em] text-white/70 sm:right-10">SŠPU Opava · 01 / 01</p>
      </article>
    </div>
  </section>

  <nav aria-label="Studijní obory" class="container-page pb-10 sm:pb-14"><div class="overflow-hidden rounded-2xl shadow-lift"><ul class="grid sm:grid-cols-2 lg:grid-cols-5">{programStrip.map((program) => <li><a href={program.href} class="group flex min-h-20 items-center justify-between gap-3 px-5 py-4 text-sm font-black uppercase tracking-wide no-underline transition hover:brightness-110 focus-visible:relative" style={`background-color:${program.color};color:${program.textColor}`}><span>{program.label}</span><span aria-hidden="true" class="text-lg transition group-hover:translate-x-1">→</span></a></li>)}</ul></div></nav>

  <section class="container-page grid gap-8 pb-16 sm:pb-20 lg:grid-cols-[1.2fr_.8fr]">
    <div><p class="eyebrow">Střední škola průmyslová a umělecká</p><h2 class="mt-3">Pět oborů. Jedna škola. Spousta možností.</h2><p class="prose-school mt-5">Spojujeme techniku, digitální svět a tvorbu. V dílnách, ateliérech i laboratořích si zkoušíte, co dokážete — s lidmi, kteří rozumí oboru i praxi.</p><a href={withBase('/obory/')} class="mt-6 inline-flex font-bold text-brand no-underline hover:text-night">Prozkoumat všechny obory →</a></div>
    <aside class="rounded-3xl bg-night p-7 text-white"><p class="text-sm font-bold uppercase tracking-wider text-accent">Nepřehlédněte</p><h2 class="mt-3 text-2xl text-white">Zahájení školního roku 2026/2027</h2><p class="mt-3 leading-7 text-white/75">V úterý 1. září v 8:00. První ročníky začínají v aule, vyšší ročníky v kmenových učebnách.</p><a href={withBase('/aktuality/zahajeni-skolniho-roku-2026/')} class="mt-5 inline-flex font-bold text-white">Praktické informace →</a></aside>
  </section>

  <section class="bg-mist py-16 sm:py-20"><div class="container-page"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow">Školní zpravodaj</p><h2 class="mt-2">Co se ve škole děje</h2></div><a class="button-secondary" href={withBase('/aktuality/')}>Všechny aktuality</a></div><NewsFilters categories={categories} programs={programs.map((program) => ({ id: program.id, title: program.data.title }))} /><div class="mt-7 grid gap-6 lg:grid-cols-3">{articles.slice(0, 6).map((article) => <ArticleCard article={article} />)}</div></div></section>

  <section class="container-page grid gap-8 py-16 lg:grid-cols-[1.15fr_.85fr]"><div><p class="eyebrow">Nadcházející</p><h2 class="mt-2">Kalendář, který dává smysl</h2><div class="mt-8 space-y-3">{events.slice(0, 3).map((event) => <article class="card flex gap-4 p-4 sm:p-5"><time class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-mist text-center text-xs font-bold text-brand" datetime={event.data.start.toISOString()}>{formatDate(event.data.start, { day: 'numeric', month: 'short' })}</time><div><p class="text-xs font-bold uppercase tracking-wide text-brand">{event.data.type}</p><h3 class="mt-1 text-lg"><a href={withBase(`/udalosti/${event.id}/`)} class="no-underline hover:text-brand">{event.data.title}</a></h3><p class="mt-1 text-sm text-ink/70">{event.data.location}</p></div></article>)}</div><a href={withBase('/udalosti/')} class="mt-6 inline-flex font-bold text-brand">Celý přehled akcí →</a></div><aside class="rounded-3xl bg-brand p-7 text-white"><p class="text-sm font-bold uppercase tracking-wider text-white/70">Pro uchazeče</p><h2 class="mt-4 text-3xl text-white">Nejlepší způsob, jak si vybrat? Přijít se podívat.</h2><p class="mt-4 leading-7 text-white/80">Seznamte se s ateliéry, dílnami, laboratořemi i lidmi, kteří budou u vašeho studia.</p><a href={withBase('/uchazeci/')} class="button-primary mt-7 !bg-white !text-night hover:!bg-accent">Přijímací řízení</a></aside></section>

  <section class="bg-night py-16 text-white"><div class="container-page"><div class="flex items-end justify-between gap-5"><div><p class="eyebrow !text-accent">Škola obrazem</p><h2 class="mt-2 text-white">Prostor pro práci i nápady</h2></div><a class="font-bold text-white" href={withBase('/galerie/')}>Všechny galerie →</a></div><div class="mt-8 grid gap-5 md:grid-cols-2">{galleries.map((gallery) => <a href={withBase(`/galerie/${gallery.id}/`)} class="group relative overflow-hidden rounded-3xl no-underline"><img src={withBase(gallery.data.cover)} alt="" class="h-64 w-full object-cover opacity-80 transition duration-300 group-hover:scale-105 group-hover:opacity-100" loading="lazy"/><span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-night/90 px-6 pb-6 pt-20"><span class="text-sm font-bold text-accent">{formatDate(gallery.data.date)}</span><strong class="mt-1 block font-display text-2xl text-white">{gallery.data.title}</strong></span></a>)}</div></div></section>

  <section class="container-page py-16"><p class="eyebrow">Rychlý rozcestník</p><div class="mt-6 grid gap-4 md:grid-cols-3"><a href={withBase('/uchazeci/')} class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Uchazeči</h2><p class="mt-3 leading-7 text-ink/70">Obory, přijímačky a dny otevřených dveří.</p></a><a href={withBase('/studenti/')} class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Studenti a rodiče</h2><p class="mt-3 leading-7 text-ink/70">Dokumenty, podpora a školní systémy.</p></a><a href={withBase('/kontakt/')} class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Veřejnost a partneři</h2><p class="mt-3 leading-7 text-ink/70">Kontakty, spolupráce a informace o škole.</p></a></div></section>
</BaseLayout>
