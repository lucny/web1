---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, formatDate } from '../../lib/content';
import AttachmentList from '../../components/content/AttachmentList.astro';
import PageHero from '../../components/content/PageHero.astro';
export async function getStaticPaths() { return (await entries('documents')).map((document) => ({ params: { slug: document.id }, props: { document } })); }
const { document } = Astro.props;
---
<BaseLayout title={document.data.title} description={document.data.description} seo={document.data.seo} breadcrumbs={[{ label: 'Dokumenty', href: '/dokumenty/' }, { label: document.data.title }]}>
  <PageHero eyebrow={document.data.category} title={document.data.title} description={document.data.description} accent="#59BDDC" /><article class="container-page pb-12 sm:pb-16" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Dokument</span>{document.data.programs.map((program) => <span class="sr-only" data-pagefind-filter="obor">{program}</span>)}<div class="mx-auto max-w-3xl"><dl class="mt-10 grid gap-5 rounded-3xl bg-mist p-6 sm:grid-cols-2"><div><dt class="text-sm font-bold text-ink/65">Vydáno</dt><dd class="mt-1">{formatDate(document.data.date)}</dd></div>{document.data.validUntil && <div><dt class="text-sm font-bold text-ink/65">Platnost do</dt><dd class="mt-1">{formatDate(document.data.validUntil)}</dd></div>}<div><dt class="text-sm font-bold text-ink/65">Štítky</dt><dd class="mt-1">{document.data.tags.join(', ')}</dd></div></dl><AttachmentList attachments={[{ label: 'Otevřít dokument / zdroj', url: document.data.file }]} eyebrow="" title="" class="mt-8" /></div></article>
</BaseLayout>
