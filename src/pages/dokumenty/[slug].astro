---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, formatDate, withBase } from '../../lib/content';
export async function getStaticPaths() { return (await entries('documents')).map((document) => ({ params: { slug: document.id }, props: { document } })); }
const { document } = Astro.props;
---
<BaseLayout title={document.data.title} description={document.data.description} seo={document.data.seo} breadcrumbs={[{ label: 'Dokumenty', href: '/dokumenty/' }, { label: document.data.title }]}>
  <article class="container-page py-12 sm:py-16" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Dokument</span>{document.data.programs.map((program) => <span class="sr-only" data-pagefind-filter="obor">{program}</span>)}<div class="mx-auto max-w-3xl"><p class="eyebrow">{document.data.category}</p><h1 class="mt-3">{document.data.title}</h1><p class="mt-6 text-xl leading-8 text-ink/80">{document.data.description}</p><dl class="mt-10 grid gap-5 rounded-3xl bg-mist p-6 sm:grid-cols-2"><div><dt class="text-sm font-bold text-ink/65">Vydáno</dt><dd class="mt-1">{formatDate(document.data.date)}</dd></div>{document.data.validUntil && <div><dt class="text-sm font-bold text-ink/65">Platnost do</dt><dd class="mt-1">{formatDate(document.data.validUntil)}</dd></div>}<div><dt class="text-sm font-bold text-ink/65">Štítky</dt><dd class="mt-1">{document.data.tags.join(', ')}</dd></div></dl><a class="button-primary mt-8" href={withBase(document.data.file)} rel="noopener">Otevřít dokument / zdroj <span aria-hidden="true" class="ml-2">↗</span></a></div></article>
</BaseLayout>
