---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, withBase } from '../../lib/content';
import PageHero from '../../components/content/PageHero.astro';
import { heroImages } from '../../data/heroImages';
const documentPages = (await entries('pages'))
  .filter((page) => page.id.startsWith('dokumenty-'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'cs'));
---
<BaseLayout title="Dokumenty" description="Přehled důležitých dokumentů a povinně zveřejňovaných informací školy.">
  <PageHero eyebrow="Dokumenty" title="Důležité školní dokumenty" description="Přehled předpisů, zpráv, rozvrhů a dalších veřejných informací školy." accent="#59BDDC" icon={heroImages.documents} iconBackground="#001731" />
  <section class="container-page pb-10 sm:pb-14" data-pagefind-body>
    <span class="sr-only" data-pagefind-filter="typ">Přehled dokumentů</span>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {documentPages.map((page) => <a href={withBase(`/cs/dokumenty/${page.id.slice('dokumenty-'.length)}/`)} target="_blank" rel="noopener" class="card group flex h-full flex-col p-5 no-underline transition hover:-translate-y-0.5 hover:shadow-soft">
        <p class="section-label">Dokumenty</p>
        <h2 class="mt-3 text-xl text-night transition group-hover:text-brand">{page.data.title}</h2>
        <p class="mt-3 flex-1 text-sm leading-6 text-ink/70">{page.data.description}</p>
        <span class="mt-5 text-sm font-bold text-brand">Otevřít stránku <span aria-hidden="true">↗</span></span>
      </a>)}
    </div>
  </section>
</BaseLayout>
