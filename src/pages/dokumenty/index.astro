---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entries, formatDate } from '../../lib/content';
const documents = await entries('documents');
const categories = [...new Set(documents.map((document) => document.data.category))];
---
<BaseLayout title="Dokumenty" description="Přehled veřejných dokumentů SŠPU Opava s metadaty, platností a vazbami na obory."><section class="container-page py-14 sm:py-20" data-pagefind-body><span class="sr-only" data-pagefind-filter="typ">Přehled dokumentů</span><p class="eyebrow">Dokumenty</p><h1 class="mt-3">Důležité informace, které najdete rychle.</h1><div class="mt-8 flex flex-wrap gap-2">{categories.map((category) => <a href={`#${category.toLowerCase().replaceAll(' ', '-')}`} class="rounded-full border border-ink/15 px-3 py-2 text-sm font-bold no-underline hover:border-brand hover:text-brand">{category}</a>)}</div><div class="mt-10 space-y-8">{categories.map((category) => <section id={category.toLowerCase().replaceAll(' ', '-')}><h2 class="text-2xl">{category}</h2><div class="mt-4 grid gap-4">{documents.filter((document) => document.data.category === category).map((document) => <article class="card flex flex-col gap-5 p-5 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-wide text-brand">Aktualizováno {formatDate(document.data.date)}</p><h3 class="mt-2 text-xl"><a href={`/dokumenty/${document.id}/`} class="no-underline hover:text-brand">{document.data.title}</a></h3><p class="mt-2 text-sm leading-6 text-ink/70">{document.data.description}</p></div><a class="button-secondary shrink-0" href={`/dokumenty/${document.id}/`}>Detail</a></article>)}</div></section>)}</div></section></BaseLayout>
