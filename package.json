{
  "name": "sspu-opava-modern-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moderní prototyp veřejného webu SŠPU Opava postavený na Astro a Git-based obsahu.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && npm run search:index",
    "preview": "astro preview",
    "cms": "decap-server",
    "search:index": "pagefind --site dist",
    "check:content": "node scripts/validate-content.mjs",
    "check:pages-cms": "node scripts/validate-pages-config.mjs",
    "check:links": "node scripts/check-links.mjs",
    "media:optimize": "node scripts/optimize-images.mjs",
    "media:convert": "node scripts/convert-jpg-to-webp.mjs",
    "check": "astro check && npm run check:content && npm run check:pages-cms",
    "test": "npm run check && npm run build && npm run check:links",
    "gallery:create": "node scripts/create-gallery.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.16.6",
    "decap-cms-app": "^3.6.0",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "decap-server": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
